# Local distributed profile
SECRET_KEY=replace-with-a-long-random-secret
MINIO_ACCESS_KEY=cloudvault
MINIO_SECRET_KEY=replace-with-a-strong-secret

# Public Vite/Supabase profile
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional future generative-AI provider.
# Core CloudVault storage and semantic search do not require this.
GEMINI_API_KEY=


# CloudVault v2 large-object provider (server-side only)
# Primary target: Backblaze B2 S3-Compatible API
B2_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_REGION=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Legacy optional Cloudflare R2 compatibility
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional vendor-neutral OTLP tracing endpoint for the local FastAPI profile
OTEL_EXPORTER_OTLP_ENDPOINT=
