# Local distributed profile
SECRET_KEY=replace-with-a-long-random-secret
MINIO_ACCESS_KEY=cloudvault
MINIO_SECRET_KEY=replace-with-a-strong-secret

# Public Vite/Supabase profile
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional future generative-AI provider.
# Core CloudVault storage and semantic search do not require this.
GEMINI_API_KEY=
