SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://cloudvault:cloudvault@postgres:5432/cloudvault
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cloudvault
MINIO_SECRET_KEY=replace-this-secret
MINIO_BUCKET=cloudvault
MINIO_SECURE=false
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=cloudvault-files
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=100
DEFAULT_STORAGE_QUOTA_MB=1024
